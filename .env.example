# 复制为 .env 后可被 docker compose 自动读取

# ---------- 端口 ----------
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=10100

# ---------- 资源与并发 ----------
# 同时运行的模型数量上限（小内存服务器建议 1）
HUB_MAX_RUNNING_MODELS=2
HUB_PORT_POOL_START=7001
HUB_PORT_POOL_END=7099

# ---------- 鉴权 ----------
# 对外网关（WS ASR / HTTP TTS）是否强制校验 API Key
HUB_REQUIRE_API_KEY=true
# 管理接口密钥，留空表示管理接口不鉴权（仅建议内网使用）
HUB_ADMIN_KEY=

# ---------- CORS ----------
HUB_CORS_ORIGINS=*

# ---------- 前端 ----------
# 使用 nginx profile 时留空即可（同源）；直连 backend 时填 ws://<主机>:8000
NEXT_PUBLIC_WS_BASE=
