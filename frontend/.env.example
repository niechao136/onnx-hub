# 后端地址（服务端 rewrites 使用，容器内填 http://backend:8000）
BACKEND_URL=http://127.0.0.1:8000

# 浏览器直接访问后端时使用；留空表示走同源（由 Next.js rewrites / Nginx 代理）
NEXT_PUBLIC_API_BASE=

# WebSocket 网关地址前缀。
# 留空 = 同源（推荐）：浏览器用 ws(s)://<当前域名>/ws/... ，由 Nginx / 网关转发到后端，
# 因此入口端口变化时无需重新构建前端。
# 仅当浏览器无法通过同源访问 /ws 时才需要显式指定，例如本地开发（前端 3000、后端 8000）：
#   NEXT_PUBLIC_WS_BASE=ws://localhost:8000
# 注意：该值在 `next build` 时被内联进产物，改动后需要重新构建（docker compose build frontend）。
NEXT_PUBLIC_WS_BASE=
